# Copy to .env and fill in. Phase 0 only needs DATABASE_URL — see
# docs/design/phase-0-foundation.md §7.3.
DATABASE_URL=postgresql://dba2:dba2@localhost:5435/dba2

# Media newsroom AI writer (docs/design/media-v2-step8-anthropic-writer.md).
# Runs on your `claude` CLI subscription login -- there is deliberately NO API
# key setting; an ANTHROPIC_API_KEY in the environment is stripped from the
# child process so it can never silently bill the API.
# Master switch. false = template-only stories, exactly as before.
MEDIA_AI_ENABLED=false
# Absolute path to the claude executable. Empty = auto-resolve (claude.cmd on Windows).
# MEDIA_AI_CLI_PATH=
# Passed to --model. Always explicit: a config-less run falls back to an expensive default.
# MEDIA_AI_MODEL=sonnet
# Passed to --effort (low keeps a 350-character blurb from paying for extended thinking).
# MEDIA_AI_EFFORT=low
# Comma-separated persona keys to rewrite (rollout knob). Empty = every persona.
# MEDIA_AI_PERSONAS=
# Most stories rewritten per cycle, highest salience first.
# MEDIA_AI_MAX_STORIES_PER_CYCLE=6
# Per-call wall-clock timeout in seconds (measured median is ~4.6s).
# MEDIA_AI_TIMEOUT_S=90
# Concurrent CLI calls per pass.
# MEDIA_AI_CONCURRENCY=2
# Calls one story may take when the fact gates reject its text: 3 = up to 2
# retries, 1 = no retry (the original behavior). CLI failures are never retried.
# MEDIA_AI_MAX_ATTEMPTS=3
# Most CLI calls one pass may spend, retries included.
# Empty = MEDIA_AI_MAX_STORIES_PER_CYCLE x MEDIA_AI_MAX_ATTEMPTS.
# MEDIA_AI_MAX_CALLS_PER_CYCLE=
